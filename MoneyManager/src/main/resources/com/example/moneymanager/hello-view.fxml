        </AnchorPane>
        <Label fx:id="balanceLabel" layoutX="231.0" layoutY="114.0" prefHeight="43.0" prefWidth="338.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Current Balance: 0.00" textFill="#ffa000" textOverrun="WORD_ELLIPSIS">
